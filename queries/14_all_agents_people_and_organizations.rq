PREFIX ex: <https://movie-lod-semantic-web.laminhtrung2001.chatgpt.site/ontology#>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# rdfs:subClassOf* is a plain property path over the schema's class triples (no reasoner needed):
# it matches ex:ProductionCompany individuals as Organization members without a materialized rdf:type.
SELECT (COUNT(DISTINCT ?person) AS ?people) (COUNT(DISTINCT ?org) AS ?organizations) WHERE {
  { ?person a dbo:Person }
  UNION
  { ?org a ?orgClass . ?orgClass rdfs:subClassOf* ex:Organization . ?org a ?orgClass }
}
