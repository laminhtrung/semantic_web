PREFIX ex: <https://movie-lod-semantic-web.laminhtrung2001.chatgpt.site/ontology#>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?title ?year WHERE {
  ?person owl:sameAs <http://www.wikidata.org/entity/Q25191> .
  ?film dbo:director ?person ; ex:title ?title .
  OPTIONAL { ?film ex:releaseYear ?year }
} ORDER BY ?year
